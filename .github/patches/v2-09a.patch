diff --git a/backend/supabase/schema.sql b/backend/supabase/schema.sql
new file mode 100644
index 0000000..f4c37f1
--- /dev/null
+++ b/backend/supabase/schema.sql
@@ -0,0 +1,93 @@
+-- App-QrCodeYar v2.0 - Supabase schema reference.
+-- این فایل بعد از ایجاد پروژه اختصاصی QR یار باید با migration رسمی Supabase وارد شود.
+
+create extension if not exists pgcrypto;
+
+create table if not exists public.dynamic_qr (
+  id uuid primary key default gen_random_uuid(),
+  owner_id uuid not null references auth.users(id) on delete cascade,
+  slug text not null unique check (slug ~ '^[a-z0-9][a-z0-9_-]{2,39}$'),
+  destination_url text not null check (destination_url ~ '^https?://'),
+  enabled boolean not null default true,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+create table if not exists public.cloud_history (
+  id bigint generated always as identity primary key,
+  user_id uuid not null references auth.users(id) on delete cascade,
+  client_created_at bigint not null,
+  kind text not null check (char_length(kind) <= 40),
+  payload text not null check (char_length(payload) <= 1000),
+  favorite boolean not null default false,
+  folder text not null default '' check (char_length(folder) <= 40),
+  tags text not null default '' check (char_length(tags) <= 300),
+  synced_at timestamptz not null default now(),
+  unique(user_id, client_created_at)
+);
+
+create table if not exists public.qr_scan_events (
+  id bigint generated always as identity primary key,
+  dynamic_qr_id uuid not null references public.dynamic_qr(id) on delete cascade,
+  scanned_at timestamptz not null default now(),
+  country_code text not null default '',
+  city text not null default ''
+);
+
+-- Analytics reads are ordered by QR and time; this index prevents full scans as events grow.
+create index if not exists qr_scan_events_dynamic_scanned_idx
+  on public.qr_scan_events(dynamic_qr_id, scanned_at desc);
+
+-- Keep updated_at correct when the owner changes a Dynamic QR destination.
+create or replace function public.touch_dynamic_qr_updated_at()
+returns trigger
+language plpgsql
+set search_path = ''
+as $$
+begin
+  new.updated_at = now();
+  return new;
+end;
+$$;
+
+drop trigger if exists dynamic_qr_touch_updated_at on public.dynamic_qr;
+create trigger dynamic_qr_touch_updated_at
+before update on public.dynamic_qr
+for each row execute function public.touch_dynamic_qr_updated_at();
+
+revoke execute on function public.touch_dynamic_qr_updated_at() from public, anon, authenticated;
+
+alter table public.dynamic_qr enable row level security;
+alter table public.cloud_history enable row level security;
+alter table public.qr_scan_events enable row level security;
+
+create policy "dynamic_qr_select_own" on public.dynamic_qr for select to authenticated
+  using ((select auth.uid()) = owner_id);
+create policy "dynamic_qr_insert_own" on public.dynamic_qr for insert to authenticated
+  with check ((select auth.uid()) = owner_id);
+create policy "dynamic_qr_update_own" on public.dynamic_qr for update to authenticated
+  using ((select auth.uid()) = owner_id) with check ((select auth.uid()) = owner_id);
+create policy "dynamic_qr_delete_own" on public.dynamic_qr for delete to authenticated
+  using ((select auth.uid()) = owner_id);
+
+create policy "cloud_history_select_own" on public.cloud_history for select to authenticated
+  using ((select auth.uid()) = user_id);
+create policy "cloud_history_insert_own" on public.cloud_history for insert to authenticated
+  with check ((select auth.uid()) = user_id);
+create policy "cloud_history_update_own" on public.cloud_history for update to authenticated
+  using ((select auth.uid()) = user_id) with check ((select auth.uid()) = user_id);
+create policy "cloud_history_delete_own" on public.cloud_history for delete to authenticated
+  using ((select auth.uid()) = user_id);
+
+-- فقط مالک Dynamic QR رویدادهای اسکن همان QR را می‌بیند. کلاینت اجازه insert ندارد؛ Edge Function با Service Role ثبت می‌کند.
+create policy "qr_scan_events_select_owner" on public.qr_scan_events for select to authenticated
+  using (exists (
+    select 1 from public.dynamic_qr q
+    where q.id = qr_scan_events.dynamic_qr_id and q.owner_id = (select auth.uid())
+  ));
+
+-- Data API access؛ RLS همچنان مالکیت ردیف را enforce می‌کند.
+grant select, insert, update, delete on public.dynamic_qr to authenticated;
+grant select, insert, update, delete on public.cloud_history to authenticated;
+grant select on public.qr_scan_events to authenticated;
+grant usage, select on sequence public.cloud_history_id_seq to authenticated;
