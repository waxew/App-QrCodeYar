+@Composable
+fun V20LabelStudioPanel(preferences: PreferencesRepository, isPremium: Boolean) {
+    val context = LocalContext.current
+    var title by remember { mutableStateOf("محصول نمونه") }
+    var price by remember { mutableStateOf("12000000") }
+    var code by remember { mutableStateOf("123456789012") }
+    var format by remember { mutableStateOf(BarcodeFormat.CODE_128) }
+    var width by remember { mutableStateOf("1400") }
+    var height by remember { mutableStateOf("760") }
+    var showPrice by remember { mutableStateOf(true) }
+    var showCode by remember { mutableStateOf(true) }
+    var preview by remember { mutableStateOf<Bitmap?>(null) }
+    var message by remember { mutableStateOf("") }
+
+    Card(shape = RoundedCornerShape(22.dp)) {
+        Column(Modifier.fillMaxWidth().padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            Text("🏷️ Barcode Label Studio 2.0", fontWeight = FontWeight.Black)
+            OutlinedTextField(title, { title = it.take(48) }, Modifier.fillMaxWidth(), label = { Text("نام محصول") })
+            OutlinedTextField(price, { price = it.filter(Char::isDigit).take(14) }, Modifier.fillMaxWidth(), label = { Text("قیمت") })
+            OutlinedTextField(code, { code = it.take(64) }, Modifier.fillMaxWidth(), label = { Text("کد کالا") })
+            Row(Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                listOf(
+                    BarcodeFormat.CODE_128 to "Code128",
+                    BarcodeFormat.CODE_39 to "Code39",
+                    BarcodeFormat.EAN_13 to "EAN13",
+                    BarcodeFormat.EAN_8 to "EAN8",
+                    BarcodeFormat.DATA_MATRIX to "DataMatrix"
+                ).forEach { (value, label) ->
+                    OutlinedButton(onClick = { format = value }) { Text(if (format == value) "✓ $label" else label) }
+                }
+            }
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedTextField(width, { width = it.filter(Char::isDigit).take(4) }, Modifier.weight(1f), label = { Text("عرض px") })
+                OutlinedTextField(height, { height = it.filter(Char::isDigit).take(4) }, Modifier.weight(1f), label = { Text("ارتفاع px") })
+            }
+            Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+                Row { Text("قیمت"); Spacer(Modifier.width(4.dp)); Switch(showPrice, { showPrice = it }) }
+                Row { Text("کد"); Spacer(Modifier.width(4.dp)); Switch(showCode, { showCode = it }) }
+            }
+            Button(onClick = {
+                if (!isPremium) { message = "Label Studio پیشرفته بخشی از Pro است."; return@Button }
+                runCatching {
+                    ProductLabelRenderer.render(
+                        ProductLabelSpec(title, price.toLongOrNull() ?: 0L, code, format, showPrice, showCode),
+                        width.toIntOrNull() ?: 1400,
+                        height.toIntOrNull() ?: 760
+                    )
+                }.onSuccess { bitmap ->
+                    preview?.recycle(); preview = bitmap
+                    preferences.addHistory("LABEL-${format.name}", code)
+                    message = "پیش‌نمایش لیبل ساخته شد."
+                }.onFailure { message = it.message ?: "ساخت لیبل ناموفق بود." }
+            }, modifier = Modifier.fillMaxWidth()) { Text("ساخت لیبل حرفه‌ای 👑") }
+            preview?.let { bitmap ->
+                Image(bitmap.asImageBitmap(), "Product Label", Modifier.fillMaxWidth().height(240.dp), contentScale = ContentScale.Fit)
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    OutlinedButton(onClick = { ExportManager.savePng(context, bitmap, "label_${System.currentTimeMillis()}") }, Modifier.weight(1f)) { Text("PNG") }
+                    OutlinedButton(onClick = { ExportManager.savePdf(context, bitmap, "label_${System.currentTimeMillis()}") }, Modifier.weight(1f)) { Text("PDF") }
+                }
+            }
+            if (message.isNotBlank()) Text(message, color = MaterialTheme.colorScheme.primary)
+        }
+    }
+}
