+@Composable
+fun V20SmartTemplatePanel(preferences: PreferencesRepository, isPremium: Boolean) {
+    val context = LocalContext.current
+    var selected by remember { mutableStateOf(SmartTemplateCatalog.items.first()) }
+    var first by remember { mutableStateOf("") }
+    var second by remember { mutableStateOf("") }
+    var third by remember { mutableStateOf("") }
+    var fourth by remember { mutableStateOf("") }
+    var payload by remember { mutableStateOf("") }
+    var preview by remember { mutableStateOf<Bitmap?>(null) }
+    var message by remember { mutableStateOf("") }
+
+    fun resetFields() {
+        first = ""; second = ""; third = ""; fourth = ""; payload = ""
+        preview?.recycle(); preview = null; message = ""
+    }
+
+    fun fields(): Map<String, String> = when (selected.id) {
+        "wifi" -> mapOf("ssid" to first, "password" to second, "type" to third.ifBlank { "WPA" })
+        "business" -> mapOf("name" to first, "phone" to second, "email" to third, "url" to fourth)
+        "restaurant" -> mapOf("url" to first)
+        "instagram" -> mapOf("url" to first)
+        "product" -> mapOf("name" to first, "price" to second, "code" to third, "url" to fourth)
+        "location" -> mapOf("lat" to first, "lon" to second, "url" to third)
+        else -> mapOf("text" to first)
+    }
+
+    val labels = when (selected.id) {
+        "wifi" -> listOf("نام Wi-Fi", "رمز", "نوع امنیت: WPA/WEP/NOPASS")
+        "business" -> listOf("نام", "تلفن", "ایمیل", "وب‌سایت")
+        "restaurant" -> listOf("لینک منو")
+        "instagram" -> listOf("لینک شبکه اجتماعی")
+        "product" -> listOf("نام محصول", "قیمت", "کد کالا", "لینک محصول")
+        "location" -> listOf("Latitude", "Longitude", "لینک جایگزین نقشه")
+        else -> listOf("متن")
+    }
+
+    Card(shape = RoundedCornerShape(22.dp)) {
+        Column(Modifier.fillMaxWidth().padding(16.dp), verticalArrangement = Arrangement.spacedBy(9.dp)) {
+            Text("🪄 Smart Template Studio 2.0", fontWeight = FontWeight.Black)
+            Row(Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                SmartTemplateCatalog.items.forEach { template ->
+                    OutlinedButton(onClick = { selected = template; resetFields() }) {
+                        Text((if (selected.id == template.id) "✓ " else "") + template.emoji + " " + template.title + if (template.premium) " 👑" else "")
+                    }
+                }
+            }
+            val values = listOf(first, second, third, fourth)
+            labels.forEachIndexed { index, label ->
+                OutlinedTextField(
+                    value = values[index],
+                    onValueChange = { value ->
+                        when (index) { 0 -> first = value; 1 -> second = value; 2 -> third = value; else -> fourth = value }
+                    },
+                    modifier = Modifier.fillMaxWidth(),
+                    label = { Text(label) },
+                    singleLine = index != 0 || selected.id != "product"
+                )
+            }
+            Button(onClick = {
+                if (selected.premium && !isPremium) {
+                    message = "این Template بخشی از اشتراک Pro است."
+                    return@Button
+                }
+                runCatching {
+                    val built = SmartTemplateCatalog.payloadFor(selected.id, fields())
+                    require(built.isNotBlank()) { "اطلاعات Template کامل نیست." }
+                    val generated = CodeGenerator.qr(built, size = 768)
+                    preview?.recycle()
+                    preview = generated.bitmap
+                    payload = built
+                    preferences.addHistory("TEMPLATE-${selected.id.uppercase()}", built)
+                }.onSuccess { message = "QR قالب آماده ساخته شد." }
+                    .onFailure { message = it.message ?: "ساخت Template ناموفق بود." }
+            }, modifier = Modifier.fillMaxWidth()) { Text("ساخت QR از Template") }
+            preview?.let { bitmap ->
+                Image(bitmap.asImageBitmap(), "Smart Template QR", Modifier.fillMaxWidth().height(220.dp), contentScale = ContentScale.Fit)
+                OutlinedButton(onClick = {
+                    ExportManager.savePng(context, bitmap, "smart_${selected.id}_${System.currentTimeMillis()}")
+                    message = "PNG Template ذخیره شد."
+                }, modifier = Modifier.fillMaxWidth()) { Text("ذخیره PNG") }
+            }
+            if (payload.isNotBlank()) Text(payload, style = MaterialTheme.typography.bodySmall, maxLines = 4)
+            if (message.isNotBlank()) Text(message, color = MaterialTheme.colorScheme.primary)
+        }
+    }
+}
