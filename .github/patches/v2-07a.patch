+@Composable
+fun V20CloudPanel(preferences: PreferencesRepository, isPremium: Boolean) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val client = remember(context) { V20CloudClient(context) }
+    var session by remember { mutableStateOf<V20CloudSession?>(client.session()) }
+    var email by remember { mutableStateOf("") }
+    var password by remember { mutableStateOf("") }
+    var slug by remember { mutableStateOf("") }
+    var destination by remember { mutableStateOf("https://") }
+    var dynamicQr by remember { mutableStateOf<V20DynamicQr?>(null) }
+    var analytics by remember { mutableStateOf<V20Analytics?>(null) }
+    var preview by remember { mutableStateOf<Bitmap?>(null) }
+    var busy by remember { mutableStateOf(false) }
+    var message by remember { mutableStateOf("") }
+
+    Card(shape = RoundedCornerShape(22.dp)) {
+        Column(Modifier.fillMaxWidth().padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            Text("☁️ Cloud / Dynamic QR 2.0", fontWeight = FontWeight.Black)
+            if (!client.config.configured) {
+                Text("Backend اختصاصی QR یار داخل سورس آماده است، اما هنوز SUPABASE_URL و Publishable Key این پروژه تنظیم نشده‌اند.")
+                Text("تا زمان Deploy، برنامه کاملاً آفلاین کار می‌کند و هیچ داده‌ای ارسال نمی‌شود.", style = MaterialTheme.typography.bodySmall)
+            } else {
+                val current = session
+            if (current == null) {
+                OutlinedTextField(email, { email = it.take(120) }, Modifier.fillMaxWidth(), label = { Text("ایمیل") }, singleLine = true)
+                OutlinedTextField(password, { password = it.take(80) }, Modifier.fillMaxWidth(), label = { Text("رمز عبور") }, singleLine = true, visualTransformation = PasswordVisualTransformation())
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    Button(onClick = {
+                        busy = true
+                        scope.launch { runCatching { client.signIn(email, password) }.onSuccess { session = it.session; message = it.message }.onFailure { message = it.message ?: "ورود ناموفق بود." }; busy = false }
+                    }, enabled = !busy, modifier = Modifier.weight(1f)) { Text("ورود") }
+                    OutlinedButton(onClick = {
+                        busy = true
+                        scope.launch { runCatching { client.signUp(email, password) }.onSuccess { session = it.session; message = it.message }.onFailure { message = it.message ?: "ثبت‌نام ناموفق بود." }; busy = false }
+                    }, enabled = !busy, modifier = Modifier.weight(1f)) { Text("ثبت‌نام") }
+                }
+            } else {
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    Text("حساب: ${current.email}", Modifier.weight(1f), style = MaterialTheme.typography.bodySmall)
+                    OutlinedButton(onClick = { client.signOutLocal(); session = null; dynamicQr = null; analytics = null }) { Text("خروج") }
+                }
+                if (!isPremium) Text("Dynamic QR، Cloud Sync و Analytics بخشی از اشتراک Pro هستند.", color = MaterialTheme.colorScheme.primary)
+                OutlinedTextField(slug, { slug = it.lowercase().filter { ch -> ch.isLetterOrDigit() || ch == '-' || ch == '_' }.take(40) }, Modifier.fillMaxWidth(), label = { Text("Slug عمومی") }, singleLine = true)
+                OutlinedTextField(destination, { destination = it.take(1000) }, Modifier.fillMaxWidth(), label = { Text("لینک مقصد") })
+                Button(onClick = {
+                    if (!isPremium) { message = "ابتدا اشتراک Pro را فعال کنید."; return@Button }
+                    busy = true
+                    scope.launch {
+                        runCatching { client.upsertDynamicQr(slug, destination) }
+                            .onSuccess { qr ->
+                                dynamicQr = qr
+                                preview?.recycle(); preview = CodeGenerator.qr(qr.publicUrl, size = 768).bitmap
+                                message = "Dynamic QR ذخیره شد؛ با همین Slug می‌توانید مقصد را بعداً تغییر دهید."
+                            }.onFailure { message = it.message ?: "ساخت Dynamic QR ناموفق بود." }
+                        busy = false
+                    }
+                }, enabled = !busy, modifier = Modifier.fillMaxWidth()) { Text("ساخت / بروزرسانی Dynamic QR 👑") }
+                dynamicQr?.let { qr ->
+                    Text(qr.publicUrl, style = MaterialTheme.typography.bodySmall)
+                    preview?.let { bitmap ->
+                        Image(bitmap.asImageBitmap(), "Dynamic QR", Modifier.fillMaxWidth().height(220.dp), contentScale = ContentScale.Fit)
+                        OutlinedButton(onClick = { ExportManager.savePng(context, bitmap, "dynamic_${qr.slug}_${System.currentTimeMillis()}") }, Modifier.fillMaxWidth()) { Text("ذخیره Dynamic QR") }
+                    }
+                }
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    OutlinedButton(onClick = {
+                        if (!isPremium) { message = "Cloud Sync نیازمند Pro است."; return@OutlinedButton }
+                        busy = true
+                        scope.launch {
+                            runCatching {
+                                client.pushHistory(preferences.history())
+                                val remote = client.pullHistory()
+                                val merged = (preferences.history() + remote).distinctBy { "${it.createdAt}|${it.kind}|${it.payload}" }.sortedByDescending { it.createdAt }.take(500)
+                                preferences.restoreHistory(merged)
+                                merged.size
+                            }.onSuccess { message = "$it رکورد بین دستگاه و Cloud همگام شد." }
+                                .onFailure { message = it.message ?: "Sync ناموفق بود." }
+                            busy = false
+                        }
+                    }, enabled = !busy, modifier = Modifier.weight(1f)) { Text("Sync دوطرفه 👑") }
+                    OutlinedButton(onClick = {
+                        if (!isPremium) { message = "Analytics نیازمند Pro است."; return@OutlinedButton }
+                        busy = true
+                        scope.launch { runCatching { client.analytics(slug) }.onSuccess { analytics = it; message = "Analytics بروزرسانی شد." }.onFailure { message = it.message ?: "Analytics ناموفق بود." }; busy = false }
+                    }, enabled = !busy, modifier = Modifier.weight(1f)) { Text("Analytics 👑") }
+                }
+                analytics?.let { data ->
+                    Text("اسکن‌های اخیر: ${data.totalRecentScans}", fontWeight = FontWeight.Bold)
+                    Text("کشورها: ${data.countries.entries.sortedByDescending { it.value }.take(5).joinToString { "${it.key}:${it.value}" }}", style = MaterialTheme.typography.bodySmall)
+                    Text("شهرها: ${data.cities.entries.sortedByDescending { it.value }.take(5).joinToString { "${it.key}:${it.value}" }}", style = MaterialTheme.typography.bodySmall)
+                }
+            }
+                if (busy) Text("در حال ارتباط با Backend…", style = MaterialTheme.typography.bodySmall)
+                if (message.isNotBlank()) Text(message, color = MaterialTheme.colorScheme.primary)
+            }
+        }
+    }
+}
